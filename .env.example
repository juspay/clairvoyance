# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
PORT=8000
HOST="0.0.0.0"
UVICORN_RELOAD=true
UVICORN_LOG_LEVEL="info"
ENVIRONMENT="dev" # "dev" or "production"
APP_BASE_URL=""
CLOUD_ENVIRONMENT="GCP" # "GCP" or "AWS"

# -----------------------------------------------------------------------------
# Logging, Tracing & Observability
# -----------------------------------------------------------------------------
PROD_LOG_LEVEL="INFO" # Only applies when ENVIRONMENT="production"
ENABLE_TRACING=false
OPEN_OBSERVE_BASE_URL="https://periscope.breeze.in"

# -----------------------------------------------------------------------------
# Langfuse Configuration
# -----------------------------------------------------------------------------
ENABLE_LANGFUSE_PROMPTS=false
LANGFUSE_SECRET_KEY=""
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_BASEURL="https://us.cloud.langfuse.com"
AUTOMATIC_LANGFUSE_PROMPT_NAME="AUTOMATIC_VOICE_LANGFUSE_PROMPT"
AUTOMATIC_LANGFUSE_SYSTEM_PROMPT_LABEL="automatic_system_langfuse_prompt"

# -----------------------------------------------------------------------------
# AI & LLM Configuration
# -----------------------------------------------------------------------------
GEMINI_API_KEY=""
ENABLE_SEARCH_GROUNDING=true
GEMINI_SEARCH_RESULT_API_MODEL="gemini-2.5-flash-lite-preview-06-17"
GOOGLE_CREDENTIALS_JSON=""
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_MODEL="gpt-4o-automatic"

# -----------------------------------------------------------------------------
# Daily Configuration
# -----------------------------------------------------------------------------
DAILY_API_KEY=""
DAILY_API_URL="https://api.daily.co/v1"
MAX_DAILY_SESSION_LIMIT=1800
ENABLE_AUTOMATIC_DAILY_RECORDING=false

# -----------------------------------------------------------------------------
# STT (Speech-to-Text) Configuration
# -----------------------------------------------------------------------------
STT_PROVIDER="google" # Options: google, assemblyai, openai, deepgram, soniox

# OpenAI STT
OPENAI_STT_API_KEY=""
OPENAI_STT_MODEL="gpt-4o-transcribe"
ENFORCED_OPENAI_STT_MODEL="whisper-1"
AUTOMATIC_OPENAI_STT_PROMPT=""
ENABLE_OPENAI_FOR_MIA=false

# AssemblyAI STT
ASSEMBLYAI_API_KEY=""

# Deepgram STT
DEEPGRAM_API_KEY=""
DEEPGRAM_MODEL="nova-3-general"
DEEPGRAM_LANGUAGE="en"
DEEPGRAM_ENDPOINTING=true
DEEPGRAM_VAD_EVENTS=true
DEEPGRAM_UTTERANCE_END_MS=1000
DEEPGRAM_NO_DELAY=true
DEEPGRAM_SMART_FORMAT=true
DEEPGRAM_PUNCTUATE=true
DEEPGRAM_NUMERALS=true
DEEPGRAM_PROFANITY_FILTER=false
DEEPGRAM_DIARIZE=false
DEEPGRAM_AUTO_DETECT_LANGUAGE=false

# Soniox STT
SONIOX_API_KEY=""
SONIOX_MODEL="stt-rt-preview"
SONIOX_LANGUAGE_HINTS="en"
SONIOX_CONTEXT="PSR, GMV, UPI, ROAS, AOV, RTO, COD, Sales, Cart, Abandonment, Sales, Split, What"
SONIOX_ENABLE_NON_FINAL_TOKENS=false
SONIOX_VAD_FORCE_TURN_ENDPOINT=false
SONIOX_MAX_NON_FINAL_TOKENS_DURATION_MS=0

# -----------------------------------------------------------------------------
# TTS (Text-to-Speech) Configuration
# -----------------------------------------------------------------------------
SANITIZE_TEXT_FOR_TTS=false

# ElevenLabs TTS
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID="bQQWtYx9EodAqMdkrNAc"
ELEVENLABS_RHEA_VOICE_ID="bQQWtYx9EodAqMdkrNAc"
ELEVENLABS_BB_VOICE_ID="fG9s0SXJb213f4UxVHyG"
ELEVENLABS_MODEL_ID="eleven_flash_v2_5"
ELEVENLABS_VOICE_SPEED=1.15
ELEVENLABS_TTS_SPEED=1.10

# Google TTS
GOOGLE_BRET_VOICE="en-IN-Chirp3-HD-Sadaltager"
GOOGLE_MIA_VOICE="en-IN-Chirp3-HD-Despina"

# -----------------------------------------------------------------------------
# Audio Processing Configuration
# -----------------------------------------------------------------------------
# VAD & Turn Management
VAD_CONFIDENCE=0.85
VAD_MIN_VOLUME=0.75
VAD_START_SECS=0.30
VAD_STOP_SECS=1.00
DISABLE_SILERO_VAD=false
DISABLE_VAD_FOR_PTT=true

# Filters
ENABLE_NOISE_REDUCE_FILTER=true
ENABLE_AIC_FILTER=false
AICOUSTICS_LICENSE_KEY=""
AIC_ENHANCEMENT_LEVEL=1.0
AIC_VOICE_GAIN=1.2
AIC_NOISE_GATE_ENABLE=true
ENABLE_KRISP_FILTER=false
KRISP_MODEL_PATH="/app/models/voice/krisp/krisp-viva-tel-v2.kef"

# -----------------------------------------------------------------------------
# Breeze Buddy Agent Configuration
# -----------------------------------------------------------------------------
# VAD
BREEZE_BUDDY_VAD_CONFIDENCE=0.7
BREEZE_BUDDY_VAD_START_SECS=0.2
BREEZE_BUDDY_VAD_STOP_SECS=0.8
BREEZE_BUDDY_VAD_MIN_VOLUME=0.6

# STT
BREEZE_BUDDY_STT_SERVICE="soniox"

# Soniox specific for Breeze Buddy
BREEZE_BUDDY_SONIOX_MODEL="stt-rt-preview"
BREEZE_BUDDY_SONIOX_LANGUAGE_HINTS="en,hi"
BREEZE_BUDDY_SONIOX_CONTEXT="State, Yes, Yeah, Good, Time, Yep, Later, Available, Busy, Confirm, Cancel, Repeat"
BREEZE_BUDDY_SONIOX_ENABLE_NON_FINAL_TOKENS=false
BREEZE_BUDDY_SONIOX_MAX_NON_FINAL_TOKENS_DURATION_MS=0
BREEZE_BUDDY_SONIOX_VAD_FORCE_TURN_ENDPOINT=false
AZURE_BREEZE_BUDDY_OPENAI_MODEL="gpt-4o-automatic"

# -----------------------------------------------------------------------------
# Session & Conversation Management
# -----------------------------------------------------------------------------
# Mem0
MEM0_API_KEY=""
MEM0_ENABLED=false
MEM0_MAX_FAILURES=3
MEM0_RETRY_INTERVAL=300
MEM0_SESSION_TIMEOUT=3600
MEM0_MIN_MESSAGE_LENGTH=10

# Context Summarization
ENABLE_SUMMARIZATION=true
MAX_TURNS_BEFORE_SUMMARY=10
KEEP_RECENT_TURNS=2

# Timeouts
AUTOMATIC_SESSION_INACTIVITY_TIMEOUT=900.0

# -----------------------------------------------------------------------------
# HITL (Human-in-the-Loop) Configuration
# -----------------------------------------------------------------------------
HITL_ENABLE=true
FUNCTION_CONFIRMATION_TIMEOUT=30
HITL_ACTIONS="delete"

# -----------------------------------------------------------------------------
# Tools & Features Configuration
# -----------------------------------------------------------------------------
ENABLE_CHARTS=false
MAX_CHARTS_PER_TURN=1
ENABLE_ALL_METRICS_FROM_CKH=true
BREEZE_DEFAULT_SALES_TAB="SALES"
MCP_CLIENT_TIMEOUT=30
ENABLE_TOOL_CALL_SOUND=false
TOOL_CALL_SOUND_FILE="assets/sounds/think.wav"

# Breeze MCP
ENABLE_BREEZE_MCP=false
BREEZE_MCP_ENDPOINT_PATH="/ai/neurolink"
SHOPS_FOR_BREEZE_MCP=""

# -----------------------------------------------------------------------------
# External API Configuration
# -----------------------------------------------------------------------------
# Juspay
GENIUS_API_URL="https://portal.juspay.in/api/q/query?api-type=genius-query"
EULER_DASHBOARD_API_URL="https://portal.juspay.in"

# Twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WEBSOCKET_URL=""

