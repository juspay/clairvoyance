{
  "_comment": "A lending journey on a merchant's OWN registered events. The condition reads a fact the catalog rendered from INSIDE an array: the topic declares payload.loan_applications.offers as a list with item_where [facility_type is CREDIT_LINE, offers exists] and item_numbered, so `offers` exists on the run only when at least one credit line made an offer — and carries only those lines. Every letter re-decides: a later event whose filter leaves nothing writes `offers` as None, so the run reads no offers and takes `else` — an earlier letter's offers never outlive the letter that made none. Before the call, `get-link` asks the merchant's own endpoint (the merchant_http connector, onboarded once with its base URL and auth header) for a credit-line link; the answer's `data.link` becomes the fact `payment_link`, which the call reads out and the agent sends on WhatsApp. `done` goes on to the call; `failed` (a 4xx, a missing link) waits instead of calling with nothing to say.",
  "entry": {
    "topic": "LINE_INITIATED",
    "key": "customer_id",
    "reenter": true,
    "cooldown_hours": 0
  },
  "nodes": [
    {
      "id": "is-credit-line",
      "type": "condition",
      "rules": [
        {
          "on": "yes",
          "if": [
            {
              "field": "context.offers",
              "op": "exists"
            }
          ]
        }
      ]
    },
    {
      "id": "quiet-30m",
      "type": "wait_event",
      "topics": [
        "LINE_INITIATED",
        "LINE_ACCOUNT_AGGREGATOR_REQUIRED",
        "LINE_ACCOUNT_AGGREGATOR_INITIATED",
        "LINE_ACCOUNT_AGGREGATOR_COMPLETED",
        "LINE_OFFERED",
        "LINE_OFFER_SELECTED",
        "LINE_KYC_COMPLETED",
        "LINE_LENDER_ATTEMPT_FAILED"
      ],
      "key": "$topic",
      "minutes": 30
    },
    {
      "id": "get-link",
      "type": "action",
      "connector": "merchant_http",
      "action": "request",
      "args": {
        "method": "POST",
        "path": "/credit-line/link",
        "body": {
          "customer_id": "{customer_id}"
        },
        "facts": {
          "payment_link": "data.link"
        }
      }
    },
    {
      "id": "nudge-call",
      "type": "call",
      "template_id": "TEMPLATE_ID_PLACEHOLDER"
    },
    {
      "id": "listen",
      "type": "wait_event",
      "topics": [
        "LINE_INITIATED",
        "LINE_ACCOUNT_AGGREGATOR_REQUIRED",
        "LINE_ACCOUNT_AGGREGATOR_INITIATED",
        "LINE_ACCOUNT_AGGREGATOR_COMPLETED",
        "LINE_OFFERED",
        "LINE_OFFER_SELECTED",
        "LINE_KYC_COMPLETED",
        "LINE_LENDER_ATTEMPT_FAILED"
      ],
      "key": "$topic",
      "minutes": 43200
    }
  ],
  "edges": [
    [
      "is-credit-line",
      "quiet-30m",
      "yes"
    ],
    [
      "is-credit-line",
      "listen",
      "else"
    ],
    [
      "quiet-30m",
      "get-link",
      "timeout"
    ],
    [
      "get-link",
      "nudge-call",
      "done"
    ],
    [
      "get-link",
      "listen",
      "failed"
    ],
    [
      "nudge-call",
      "listen"
    ],
    [
      "quiet-30m",
      "is-credit-line",
      "LINE_INITIATED"
    ],
    [
      "quiet-30m",
      "is-credit-line",
      "LINE_ACCOUNT_AGGREGATOR_REQUIRED"
    ],
    [
      "quiet-30m",
      "is-credit-line",
      "LINE_ACCOUNT_AGGREGATOR_INITIATED"
    ],
    [
      "quiet-30m",
      "is-credit-line",
      "LINE_ACCOUNT_AGGREGATOR_COMPLETED"
    ],
    [
      "quiet-30m",
      "is-credit-line",
      "LINE_OFFERED"
    ],
    [
      "quiet-30m",
      "is-credit-line",
      "LINE_OFFER_SELECTED"
    ],
    [
      "quiet-30m",
      "is-credit-line",
      "LINE_KYC_COMPLETED"
    ],
    [
      "quiet-30m",
      "is-credit-line",
      "LINE_LENDER_ATTEMPT_FAILED"
    ],
    [
      "listen",
      "is-credit-line",
      "LINE_INITIATED"
    ],
    [
      "listen",
      "is-credit-line",
      "LINE_ACCOUNT_AGGREGATOR_REQUIRED"
    ],
    [
      "listen",
      "is-credit-line",
      "LINE_ACCOUNT_AGGREGATOR_INITIATED"
    ],
    [
      "listen",
      "is-credit-line",
      "LINE_ACCOUNT_AGGREGATOR_COMPLETED"
    ],
    [
      "listen",
      "is-credit-line",
      "LINE_OFFERED"
    ],
    [
      "listen",
      "is-credit-line",
      "LINE_OFFER_SELECTED"
    ],
    [
      "listen",
      "is-credit-line",
      "LINE_KYC_COMPLETED"
    ],
    [
      "listen",
      "is-credit-line",
      "LINE_LENDER_ATTEMPT_FAILED"
    ]
  ],
  "goals": [
    {
      "topics": [
        "LINE_ACTIVE",
        "LINE_HARD_OFFER_REJECTED",
        "LINE_KYC_REJECTED"
      ],
      "exit_reason": "goal_met"
    }
  ],
  "exits": {
    "max_age_days": 30
  },
  "purpose_key": "utility.loan.checkout_nudge"
}
