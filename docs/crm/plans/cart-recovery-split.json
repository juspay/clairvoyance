{
  "on_publish": "migrate",
  "entry": {
    "topic": "checkouts/update",
    "reenter": true,
    "cooldown_hours": 24,
    "on_repeat": "refresh_latest",
    "debounce_minutes": 30
  },
  "goals": [
    {
      "topics": [
        "orders/create",
        "orders/paid"
      ],
      "key": {
        "event": "cart_token",
        "run": "cart_token"
      },
      "exit_reason": "goal_met"
    },
    {
      "topics": [
        "orders/create",
        "orders/paid"
      ],
      "exit_reason": "converted_elsewhere"
    }
  ],
  "exits": {
    "max_age_days": 2
  },
  "purpose_key": "utility",
  "nodes": [
    {
      "id": "wait-30m",
      "type": "wait",
      "minutes": 30
    },
    {
      "id": "which-letter",
      "type": "split",
      "arms": [
        {
          "on": "control",
          "percent": 70
        },
        {
          "on": "variant",
          "percent": 30
        }
      ]
    },
    {
      "id": "wa-control",
      "type": "send",
      "channel": "whatsapp",
      "template": "cart_recovery_1",
      "variables": {
        "1": "customer_name"
      }
    },
    {
      "id": "wa-variant",
      "type": "send",
      "channel": "whatsapp",
      "template": "cart_recovery_2",
      "variables": {
        "1": "customer_name"
      }
    },
    {
      "id": "wait-1d",
      "type": "wait",
      "minutes": 1440
    }
  ],
  "edges": [
    ["wait-30m", "which-letter"],
    ["which-letter", "wa-control", "control"],
    ["which-letter", "wa-variant", "variant"],
    ["wa-control", "wait-1d"],
    ["wa-variant", "wait-1d"]
  ]
}
