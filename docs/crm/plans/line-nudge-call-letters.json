{
  "_comment": "The lending journey whose call squares wait for their call AND hear the merchant (22 Sep 2026; docs/crm/runbooks/awaiting-call.md §A new event beats a queued call). Each call square says `\"event_name\": \"call.completed\"` and lists the merchant's topics with `match` and arrows back to the rule: a letter while the call is queued aborts that call and re-decides on the new facts (a ringing call is left to finish, and its late report yields to the letter); the call's own report takes the plain edge with the outcome on the step; `await_minutes` is the backstop, after which the queued call is aborted and the edge taken. A call to a phone that cannot be dialled or a blacklisted customer ends the run as ejected. A run that ends — goal, max age, plan archived — takes its queued calls with it.",
  "entry": {
    "topic": "LINE_INITIATED",
    "key": "customer_id",
    "reenter": true,
    "cooldown_hours": 0
  },
  "nodes": [
    {
      "id": "is-credit-line",
      "type": "condition",
      "rules": [
        {
          "on": "yes",
          "if": [
            {
              "field": "context.products",
              "op": "not_exists"
            },
            {
              "field": "context.offers",
              "op": "exists"
            }
          ]
        }
      ]
    },
    {
      "id": "quiet-30m",
      "type": "wait",
      "topics": [
        "LINE_OFFERED",
        "LINE_OFFER_SELECTED",
        "LINE_KYC_COMPLETED",
        "LINE_LENDER_ATTEMPT_FAILED"
      ],
      "key": "$topic",
      "minutes": 30,
      "window": {
        "opens": "09:00",
        "closes": "21:00",
        "timezone": "Asia/Kolkata"
      },
      "match": {
        "run": "customer_id",
        "payload": "customer_id"
      }
    },
    {
      "id": "call-1",
      "type": "call",
      "template_id": "TEMPLATE_ID_PLACEHOLDER",
      "await_minutes": 1440,
      "topics": [
        "LINE_OFFERED",
        "LINE_OFFER_SELECTED",
        "LINE_KYC_COMPLETED",
        "LINE_LENDER_ATTEMPT_FAILED"
      ],
      "match": {
        "run": "customer_id",
        "payload": "customer_id"
      },
      "event_name": "call.completed"
    },
    {
      "id": "gap-30m",
      "type": "wait",
      "topics": [
        "LINE_OFFERED",
        "LINE_OFFER_SELECTED",
        "LINE_KYC_COMPLETED",
        "LINE_LENDER_ATTEMPT_FAILED"
      ],
      "key": "$topic",
      "minutes": 30,
      "window": {
        "opens": "09:00",
        "closes": "21:00",
        "timezone": "Asia/Kolkata"
      },
      "match": {
        "run": "customer_id",
        "payload": "customer_id"
      }
    },
    {
      "id": "call-2",
      "type": "call",
      "template_id": "TEMPLATE_ID_PLACEHOLDER",
      "topics": [
        "LINE_OFFERED",
        "LINE_OFFER_SELECTED",
        "LINE_KYC_COMPLETED",
        "LINE_LENDER_ATTEMPT_FAILED"
      ],
      "match": {
        "run": "customer_id",
        "payload": "customer_id"
      },
      "event_name": "call.completed",
      "await_minutes": 1440
    },
    {
      "id": "listen",
      "type": "wait",
      "topics": [
        "LINE_OFFERED",
        "LINE_OFFER_SELECTED",
        "LINE_KYC_COMPLETED",
        "LINE_LENDER_ATTEMPT_FAILED"
      ],
      "key": "$topic",
      "match": {
        "run": "customer_id",
        "payload": "customer_id"
      }
    }
  ],
  "edges": [
