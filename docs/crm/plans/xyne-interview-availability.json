{
  "on_publish": "migrate",
  "purpose_key": "utility.interview.availability",
  "entry": {
    "topic": "interview.requested"
  },
  "goals": [
    {
      "topics": [
        "interview.scheduled"
      ]
    }
  ],
  "exits": {
    "max_age_days": 3
  },
  "nodes": [
    {
      "id": "ask-availability",
      "type": "send",
      "channel": "xyne",
      "template": "interview_slots",
      "variables": {
        "candidate_name": "candidate_name",
        "slots": "slots"
      }
    },
    {
      "id": "await-availability",
      "type": "wait",
      "topics": [
        "flow_action"
      ],
      "key": "reply",
      "minutes": 2880
    },
    {
      "id": "confirm-slots",
      "type": "call",
      "template_id": "TEMPLATE_ID_PLACEHOLDER"
    }
  ],
  "edges": [
    [
      "ask-availability",
      "await-availability"
    ],
    [
      "await-availability",
      "confirm-slots",
      "form_submitted"
    ]
  ]
}
