  "playbook": {
    "lines": {
      "hook_offered": "Namaste, aapne apne Flipkart EMI checkout ke liye {sub_category} category me order shuru kiya tha. Aapka offer ready hai, bas kuch steps baaki hain.",
      "hook_default": "Namaste, aapne Flipkart EMI par checkout shuru kiya tha. Kya main aapko guide kar doon?",
      "step_open_app": "Sabse pehle Flipkart app kholiye. Bataiye jab khul jaaye.",
      "step_cart_order": "Ab cart me jaiye, aapka {sub_category} wahin hoga. Place order par tap kijiye.",
      "step_emi_select": "Payment page par EMI section me Flipkart EMI select kijiye.",
      "step_verify_bank": "Bank account details verify karne hain, do options hain: UPI ya account details.",
      "fibe_notes": "DigiLocker missing then Sign Up takes two minutes; PIN forgotten then PIN-less authentication.",
