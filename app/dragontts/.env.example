# --- Provider credentials (names mirror clairvoyance) ---
CARTESIA_API_KEY=
SARVAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_INDIAN_RESIDENCY_API_KEY=
ELEVENLABS_INDIAN_RESIDENCY_BASE_URL=
GOOGLE_CREDENTIALS_JSON=
GOOGLE_CREDENTIALS_PATH=

# --- Storage (point both at a persistent volume in k8s) ---
DB_PATH=data/dragontts.db
BLOB_DIR=data/blobs

# --- Cache policy ---
MAX_CACHE_BYTES=0        # 0 = unlimited
TTL_SECONDS=0            # 0 = no expiry
ENABLE_WRITE_THROUGH=true

# --- Sentence splitting ---
# Split a transcript into sentences BEFORE synth/serve so each is synthesized +
# cached under its own key (recurring sentences get reused). Parts are then pure-
# concatenated — no edge trim, no inserted gap (nothing is cut; appended exactly
# as synthesized). Empty = OFF (the whole transcript is one cache entry, the
# default). Set to the symbols to split AFTER, e.g. .:?! The synth and stream
# paths are controlled INDEPENDENTLY:
SPLIT_AT_SYMBOLS=         # /tts/bytes  (one-shot synth) path; empty = OFF
SPLIT_AT_SYMBOLS_STREAM=  # /tts/stream path; empty = OFF
# Only split when EVERY resulting part has >= this many words (a lone single-word
# part isn't worth caching alone, so the whole phrase stays one entry).
SPLIT_MIN_WORDS_PER_PART=2
