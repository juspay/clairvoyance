# ---------------------------------------------------------------------------
# claude-code-metrics-sidecar configuration
# Copy to .env (or set in Cloud Run / your deployment env) and adjust.
# ---------------------------------------------------------------------------

# Where the sidecar listens for Claude Code's OTLP exports.
PORT=8080
HOST=0.0.0.0

# Where transformed (NeuroLink-shaped) telemetry is exported.
# Point this at your OTel collector's OTLP receiver, or directly at
# OpenObserve's OTLP API root: https://<openobserve-host>/api/<org>
OTEL_EXPORT_ENDPOINT=http://localhost:14318
# Per-signal overrides (optional; derived from OTEL_EXPORT_ENDPOINT by default):
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=

# Extra headers on every export request, OTEL spec format (URL-encoded).
# Direct-to-OpenObserve example:
# OTEL_EXPORT_HEADERS=Authorization=Basic%20<base64-user:pass>
OTEL_EXPORT_HEADERS=

# OpenObserve stream names for logs/traces (the collector in NeuroLink's stack
# used the `stream-name` header; OpenObserve names metric streams after the
# metric itself, so metrics ignore this).
LOGS_STREAM_NAME=neurolink_proxy
TRACES_STREAM_NAME=neurolink_proxy

# Require developers to authenticate to the sidecar. Set the same value in
# each developer's OTEL_EXPORTER_OTLP_HEADERS (see scripts/claude-env.sh).
# SIDECAR_INGEST_TOKEN=

# Flush cadence (mirrors NeuroLink defaults).
METRICS_EXPORT_INTERVAL_MS=15000
LOGS_FLUSH_INTERVAL_MS=2000
LOGS_BATCH_SIZE=64
EXPORT_TIMEOUT_MS=15000
EXPORT_RETRIES=2

# Keep forwarding raw claude_code.* metrics so existing claude_code_* streams
# and tooling keep working.
FORWARD_RAW_METRICS=true

# 'event'  — tokens/cost from api_request log events (default, exact).
# 'metric' — tokens/cost from claude_code.token.usage / cost.usage deltas
#            (fallback if log events ever disappear; never use both for long).
TOKEN_SOURCE=event

# Optional: forward non-request Claude Code events (user_prompt,
# assistant_response, mcp_server_connection, ...) to a `claude_code_events`
# stream. Off by default — the neurolink_proxy stream stays dashboard-clean.
FORWARD_OTHER_EVENTS=false

# Resource attributes stamped on exports.
SERVICE_NAME=neurolink_proxy
DEPLOYMENT_ENVIRONMENT=prod

# Cardinality guard for metric series.
MAX_SERIES=20000
