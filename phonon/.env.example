# Every setting has a safe default; see stt/config.py.
STT_ENGINE=fake
# 127.0.0.1 until auth lands (PR-13). Never 0.0.0.0 on a shared network before that.
STT_HOST=127.0.0.1
STT_PORT=8098
# macOS does not spread SO_REUSEPORT connections; keep 1 locally.
STT_FRONTENDS=1
STT_FLUSH_MS=10
STT_LOG_LEVEL=INFO
STT_LOG_JSON=false
