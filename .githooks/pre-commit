#!/bin/sh
set -e

echo "Running formatters before commit..."

# Ensure dev dependencies are available (uv handles venv automatically)
uv sync --extra dev > /dev/null 2>&1

# Run autoflake to remove unused imports and variables
uv run autoflake --in-place --remove-all-unused-imports --remove-unused-variables --exclude "app/__init__.py,.venv/*,venv/*" -r app/

# Format all python files with isort
uv run isort . --profile black

# Format all python files with black
uv run black .

echo "Running pyrefly check..."

TMP_ERR_FILE="$(mktemp)"

if ! uv run pyrefly check > "$TMP_ERR_FILE" 2>&1; then
  echo "❌ Pyrefly check failed. Commit aborted."
  mv "$TMP_ERR_FILE" error.txt
  exit 1
fi

# No errors → clean up temp file
rm "$TMP_ERR_FILE"

echo "Running field_reference.json coverage check..."

if ! uv run python -m pytest tests/test_field_reference_coverage.py -q --tb=short; then
  echo "❌ field_reference.json is out of sync with ConfigurationModel. Commit aborted."
  echo "   Add missing fields to app/ai/voice/agents/breeze_buddy/template/field_reference.json"
  exit 1
fi

# Stage updated files (if formatters changed them)
git add -u

echo "All checks passed."
